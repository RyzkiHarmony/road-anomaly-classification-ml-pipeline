{
  "pipeline_version": "2026-05-02-v1",
  "strict_label_validation": true,
  "input": {
    "candidates_events_csv": "01_labeling_pipeline/out/candidates_events.csv",
    "ground_truth_csv": "01_labeling_pipeline/out/ground_truth_labels.csv",
    "meta_glob": "01_labeling_pipeline/data/meta/*.json",
    "raw_csv_dir": "01_labeling_pipeline/data/csv"
  },
  "stable_key": {
    "time_round_s": 0.05,
    "lat_lon_decimals": 5,
    "peak_mag_decimals": 1,
    "peak_gyro_decimals": 2,
    "jerk_decimals": 2
  },
  "split": {
    "seed": "event-classification-v1",
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15
  },
  "dataset": {
    "max_review_queue": 2000,
    "feature_columns": [
      "peak_mag",
      "peak_vertical",
      "peak_mag_g",
      "peak_vertical_g",
      "peak_gyro_mag",
      "speed_mean",
      "event_duration",
      "vert_jrk",
      "num_peaks_accel",
      "num_peaks_gyro",
      "peak_interval_mean",
      "peak_interval_std",
      "asymmetry_score",
      "vertical_energy",
      "gyro_energy",
      "accel_to_gyro_ratio",
      "local_duration",
      "top2_peak_ratio",
      "duration_above_threshold",
      "max_jerk",
      "peak_to_peak",
      "fft_high_low_ratio",
      "zcr",
      "kurtosis",
      "skewness",
      "gyro_pitch_energy",
      "gyro_roll_energy",
      "gyro_yaw_energy",
      "gyro_pitch_roll_ratio",
      "speed_factor",
      "score"
    ]
  },
  "preprocessing": {
    "enabled": true,
    "target_fs_hz": 50.0,
    "output_subdir": "preprocessed_raw"
  },
  "output_dir": "03_dataset_output"
}
